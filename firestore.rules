rules_version = '2';
// 適用於 ppoc 資料庫（Named Database，非 default）
// 對應規格書 6. Firestore 安全性規則
service cloud.firestore {
  match /databases/{database}/documents {

    // 專案設定與題目：登入用戶可讀，僅 Admin 可寫
    match /settings/config {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 意願登記：一般用戶只能讀取/建立自己的登記紀錄 (Doc ID == request.auth.uid)
    // Admin 可讀取全部紀錄（後台審核列表需要 list 整個 collection）
    match /applicants/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth.token.admin == true;
    }

    // 正式回饋：一般用戶僅限提交/讀取自己的紀錄，Admin 可讀取全部以供審核
    match /submissions/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth.token.admin == true;
    }

    // 獎勵序號池：全閉鎖，必須由 Cloud Functions Admin SDK 操作
    match /rewards/{rewardId} {
      allow read, write: if false;
    }
  }
}
